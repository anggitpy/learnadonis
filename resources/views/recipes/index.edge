@layout.dashboard({ title: 'Recipes', activeNav: 'recipes' })

  @slot('actions')
    <a href="/recipes/create" class="btn btn-primary btn-sm">+ New Recipe</a>
  @endslot

  @if (recipes.length === 0)
    <div class="card bg-base-100 shadow-sm border border-base-300">
      <div class="card-body items-center text-center py-12">
        <h2 class="card-title">No recipes yet</h2>
        <p class="text-base-content/70">Add your first food recipe to see CRUD in action.</p>
        <div class="card-actions mt-4">
          <a href="/recipes/create" class="btn btn-primary">+ Create First Recipe</a>
        </div>
      </div>
    </div>
  @else
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      @each(recipe in recipes)
        <div class="card bg-base-100 shadow-sm border border-base-300">
          <div class="card-body">
            <div class="flex items-start justify-between gap-2">
              <h2 class="card-title text-lg">
                <a href="/recipes/{{ recipe.id }}" class="hover:underline">{{ recipe.title }}</a>
              </h2>
              <span class="badge badge-secondary badge-outline shrink-0">
                ⏱ {{ recipe.prepTime }} min
              </span>
            </div>

            <p class="text-sm text-base-content/70 line-clamp-3 whitespace-pre-line mt-2">{{ recipe.ingredients }}</p>

            <div class="card-actions justify-end items-center mt-4 pt-3 border-t border-base-200">
              <a href="/recipes/{{ recipe.id }}" class="btn btn-xs btn-ghost">View</a>
              <a href="/recipes/{{ recipe.id }}/edit" class="btn btn-xs btn-outline">Edit</a>
              <form method="POST" action="/recipes/{{ recipe.id }}/delete" class="inline">
                <button type="submit" class="btn btn-xs btn-error btn-outline">Delete</button>
              </form>
            </div>
          </div>
        </div>
      @endeach
    </div>
  @endif

@end
