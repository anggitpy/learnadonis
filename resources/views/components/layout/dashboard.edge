<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{-- Props passed to @layout.dashboard({ title: '...' }) are available directly --}}
    <title>{{ title || 'Dashboard' }} — LearnAdonis</title>

    {{-- DaisyUI v4 + Tailwind CDN (matching the zero-build setup in this project) --}}
    <link
      href="https://cdn.jsdelivr.net/npm/daisyui@4.12.23/dist/full.min.css"
      rel="stylesheet"
      type="text/css"
    />
    <script src="https://cdn.tailwindcss.com"></script>

    {{-- Optional named slot: pages can inject custom <head> tags with @slot('meta') --}}
    @if ($slots.meta)
      {{{ await $slots.meta() }}}
    @endif
  </head>
  <body class="bg-base-200 min-h-screen">
    {{-- DaisyUI Responsive Drawer Layout (sidebar open on desktop lg:drawer-open) --}}
    <div class="drawer lg:drawer-open">
      <input id="dashboard-drawer" type="checkbox" class="drawer-toggle" />

      {{-- Main Content Area --}}
      <div class="drawer-content flex flex-col">
        {{-- Top Navbar --}}
        <header class="navbar bg-base-100 border-b border-base-300 px-6 sticky top-0 z-10">
          <div class="flex-none lg:hidden">
            <label for="dashboard-drawer" aria-label="open sidebar" class="btn btn-square btn-ghost">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block h-6 w-6 stroke-current">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </label>
          </div>

          <div class="flex-1">
            <h1 class="text-xl font-bold">{{ title || 'Dashboard' }}</h1>
          </div>

          {{-- Named Slot for page-specific header buttons/actions --}}
          @if ($slots.actions)
            <div class="flex-none gap-2">
              {{{ await $slots.actions() }}}
            </div>
          @endif
        </header>

        {{-- Page Body: Default slot where child page content is injected --}}
        <main class="p-6 space-y-6 flex-1">
          {{{ await $slots.main() }}}
        </main>

        <footer class="footer footer-center p-4 text-base-content/60 text-sm border-t border-base-300">
          <aside>
            <p>Rendered with AdonisJS Edge Layouts &amp; daisyUI</p>
          </aside>
        </footer>
      </div>

      {{-- Left Sidebar Navigation --}}
      <div class="drawer-side z-20">
        <label for="dashboard-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
        <aside class="bg-base-100 border-r border-base-300 w-64 min-h-full flex flex-col">
          <div class="p-4 border-b border-base-300 flex items-center gap-3">
            <div class="badge badge-primary badge-lg font-bold">A</div>
            <span class="font-bold text-lg tracking-tight">LearnAdonis</span>
          </div>

          <ul class="menu p-4 gap-1 flex-1 text-base">
            <li class="menu-title">Navigation</li>
            <li>
              <a href="/dashboard" class="{{ activeNav === 'dashboard' ? 'active font-semibold' : '' }}">
                📊 Dashboard Overview
              </a>
            </li>
            <li>
              <a href="/tasks" class="{{ activeNav === 'tasks' ? 'active font-semibold' : '' }}">
                ✅ Task Tracker
              </a>
            </li>
            <li>
              <a href="/recipes" class="{{ activeNav === 'recipes' ? 'active font-semibold' : '' }}">
                🍳 Recipes
              </a>
            </li>
          </ul>

          <div class="p-4 border-t border-base-300">
            <div class="alert bg-base-200 text-xs">
              <span>💡 Layout file:<br><code>components/layout/dashboard.edge</code></span>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </body>
</html>
